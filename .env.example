# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app:apppassword@localhost:5432/predictions
DATABASE_ADMIN_URL=postgresql://admin:adminpassword@localhost:5432/predictions

# ─── Assignment ──────────────────────────────────────────────────────────────
# 32-byte hex string; rotate only in consultation with statistician
ASSIGNMENT_SALT=replace_with_64_hex_chars_random_never_guessable_never_reuse

# ─── Ed25519 server signing key (hex-encoded 32-byte seed) ───────────────────
SERVER_SIGNING_SEED=replace_with_64_hex_chars_random_server_keypair_seed

# ─── OAuth / OIDC (Auth0, Okta, or any RFC 8414 compliant issuer) ───────────
OIDC_ISSUER=https://your-tenant.us.auth0.com/
OIDC_CLIENT_ID=your_client_id
OIDC_CLIENT_SECRET=your_client_secret
OIDC_AUDIENCE=https://api.superawesomesecret.example.com

# ─── Stripe (payment fingerprint for leaderboard gating) ─────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Market data providers ───────────────────────────────────────────────────
TWELVE_DATA_API_KEY=your_twelve_data_key
MARKETAUX_API_KEY=your_marketaux_key

# ─── Public data (no key required for EIA/BLS/FRED/Fed public endpoints) ────
EIA_API_KEY=your_eia_key

# ─── S3-compatible Merkle publication ────────────────────────────────────────
MERKLE_S3_ENDPOINT=https://s3.amazonaws.com
MERKLE_S3_BUCKET=superawesomesecret-merkle-public
MERKLE_S3_REGION=us-east-1
MERKLE_S3_ACCESS_KEY=AKIA...
MERKLE_S3_SECRET_KEY=...

# ─── App config ──────────────────────────────────────────────────────────────
PORT=4000
WEB_PORT=3000
NODE_ENV=development
LOG_LEVEL=info
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
